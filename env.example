# These are public browser configuration values, safe to use in a GitHub Pages build.
# Get both Supabase values from Project Connect / API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional. Add this only after Google AdSense has approved the site.
VITE_ADSENSE_PUBLISHER_ID=pub-2209406347192595

# Optional. Sentry DSN from your GitHub Student Pack Sentry account for client crash tracking.
VITE_SENTRY_DSN=
